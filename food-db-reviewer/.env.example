# Copy to .env and fill in your real keys (never commit .env)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=nutriaudit-food-db
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=multilingual-e5-large

# Optional alternative embedding providers (only needed if --provider openai or gemini)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
