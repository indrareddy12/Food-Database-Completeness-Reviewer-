# =============================================================================
# NutriAudit: Food Database Completeness Reviewer - Environment Configuration
# =============================================================================
# Duplicate this file to .env and insert your API credentials.
# Do NOT commit .env with active credentials to source control.

# -----------------------------------------------------------------------------
# 1. Google Gemini API (Google AI Studio)
# -----------------------------------------------------------------------------
# Get your key at: https://aistudio.google.com/
# Recommended models: gemini-2.5-flash, gemini-1.5-flash, gemini-3-flash-preview
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. Groq Cloud API
# -----------------------------------------------------------------------------
# Get your key at: https://console.groq.com/
# Recommended models: llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# 3. Pinecone Vector Database (Staging for Vector Embeddings & Similarity)
# -----------------------------------------------------------------------------
# Get your key at: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=food-database-completeness
PINECONE_ENVIRONMENT=us-east-1

# -----------------------------------------------------------------------------
# 4. Local Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
PORT=8000
